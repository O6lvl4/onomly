#!/bin/sh
# onomly — product-name availability sweep. One command, best engine wins:
#   native almide -> bundled WASI 0.3 component under wasmtime -> serial bash.
# Usage: onomly <name> [name2 ...]      Force: ONOMLY_ENGINE=almide|wasm|bash
set -eu
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ $# -lt 1 ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  echo "usage: onomly <name> [name2 ...]   (ONOMLY_ENGINE=almide|wasm|bash to force)" >&2
  exit 2
fi

almide_ok() { # almide >= 0.61.0 on PATH
  command -v almide >/dev/null 2>&1 || return 1
  v=$(almide --version 2>/dev/null | awk '{print $2}')
  maj=${v%%.*}; rest=${v#*.}; min=${rest%%.*}
  [ "${maj:-0}" -gt 0 ] 2>/dev/null || [ "${min:-0}" -ge 61 ] 2>/dev/null
}

engine=${ONOMLY_ENGINE:-}
if [ -z "$engine" ]; then
  if almide_ok; then engine=almide
  elif command -v wasmtime >/dev/null 2>&1; then engine=wasm
  else engine=bash
  fi
fi

case "$engine" in
  almide) exec almide run "$DIR/onomly.almd" -- "$@" ;;
  wasm)   printf '%s\n' "$*" | exec wasmtime run \
            -W component-model-async=y,component-model-more-async-builtins=y \
            -S p3=y -S http=y "$DIR/onomly.wasm" ;;
  bash)   exec bash "$DIR/onomly.sh" "$@" ;;
  *)      echo "onomly: unknown engine '$engine' (almide|wasm|bash)" >&2; exit 2 ;;
esac
